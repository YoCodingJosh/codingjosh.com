/**
 * Wrangler configuration for codingjosh.com (TanStack Start on Cloudflare Workers).
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets (set with `wrangler secret put <NAME>`, or in `.dev.vars` locally):
 *   MAL_CLIENT_ID         MyAnimeList API client ID (https://myanimelist.net/apiconfig)
 *   TURNSTILE_SECRET_KEY  Cloudflare Turnstile secret for the contact email reveal
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codingjosh",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "e59a4950bd764ebaa9a0bc909a45aae4",
    },
  ],
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAAOy57qtbm5qluJY",
  },
}
